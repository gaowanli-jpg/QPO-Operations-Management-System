POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
DB_POOL_MAX_SIZE=15
DB_POOL_MIN_IDLE=3
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_MAX_LIFETIME_MS=1800000
DB_POOL_VALIDATION_TIMEOUT_MS=3000
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8088
ERP_JWT_SECRET=
ERP_JWT_TTL_MINUTES=720

# Legacy APS compatibility. APS is historical only; QPO new integrations use MES/WMS/U9.
# Backend reads ERP_APS_SOURCE_TOKEN for /api/aps/source; APS_ERP_* is kept for old local bridge tooling.
ERP_APS_SOURCE_TOKEN=
APS_ERP_BASE_URL=http://localhost:8080
APS_ERP_AUTH_TOKEN=

# Data Center outbound gateway fallback values.
# QPO calls Data Center first; Data Center forwards requests to MES/WMS/U9.
# System Config > Outbound Interface can override these values after deployment.
# Keep DATA_CENTER client secrets in real erp.env only; never commit them.
ERP_DATA_CENTER_ENABLED=true
ERP_DATA_CENTER_BASE_URL=http://192.168.70.250:8080
ERP_DATA_CENTER_TOKEN_URL=http://192.168.70.250:8080/realms/api-platform/protocol/openid-connect/token
ERP_DATA_CENTER_CLIENT_ID=app_8ed28b2a1faf4a0b
ERP_DATA_CENTER_CLIENT_SECRET=
ERP_DATA_CENTER_GRANT_TYPE=client_credentials
ERP_DATA_CENTER_CONNECT_TIMEOUT_MS=5000
ERP_DATA_CENTER_READ_TIMEOUT_MS=30000
ERP_DATA_CENTER_TOKEN_EXPIRE_SKEW_SECONDS=60

# Data Center business endpoint fallback paths. Fill these after Data Center confirms gateway paths.
ERP_DATA_CENTER_MES_MATERIAL_PATH=
ERP_DATA_CENTER_WMS_ALLOCATION_PATH=
ERP_DATA_CENTER_U9_SALES_ORDER_SYNC_PATH=
ERP_DATA_CENTER_U9_COMMON_ENTITY_QUERY_PATH=
ERP_DATA_CENTER_MES_PRODUCTION_DISPATCH_PATH=

# deprecated direct-system fallback values.
# ERP_MES/ERP_WMS/ERP_U9 are retained only for local-dev, old deployments, and emergency rollback
# when Data Center is not configured or temporarily disabled. Keep secrets in real erp.env only;
# never commit them.

# MES material-number sync fallback. Leave BASE_URL empty only when MES integration is not ready.
ERP_MES_BASE_URL=
ERP_MES_AUTH_TOKEN=
ERP_MES_MATERIAL_PATH=/api/mes/materials/resolve
ERP_MES_TIMEOUT_MS=10000

# WMS inventory allocation fallback. Requires MES material_no on the delivered item first.
ERP_WMS_BASE_URL=
ERP_WMS_AUTH_TOKEN=
ERP_WMS_ALLOCATION_PATH=/api/wms/inventory/allocate
ERP_WMS_TIMEOUT_MS=10000

# U9 sales order sync fallback. Leave BASE_URL empty only when U9 integration is not ready.
ERP_U9_BASE_URL=
ERP_U9_USER_CODE=
ERP_U9_ENT_CODE=
ERP_U9_ORG_CODE=
ERP_U9_CLIENT_ID=
ERP_U9_CLIENT_SECRET=
ERP_U9_CONNECT_TIMEOUT_MS=5000
ERP_U9_READ_TIMEOUT_MS=30000

# File storage strategy. Local development and first deployment default to LOCAL.
ERP_FILE_STORAGE_TYPE=LOCAL
ERP_MINIO_ENDPOINT=
ERP_MINIO_BUCKET=
ERP_MINIO_ACCESS_KEY=
ERP_MINIO_SECRET_KEY=
ERP_MINIO_REGION=us-east-1
ERP_MINIO_PATH_STYLE=true
ERP_CONFIG_SECRET_KEY=

# Optional local MinIO container for validating MINIO storage. Leave unused for normal LOCAL development.
MINIO_IMAGE=minio/minio:latest
MINIO_BIND=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=qpo_minio_admin
MINIO_ROOT_PASSWORD=
MINIO_MEM_LIMIT=512m
MINIO_CPUS=0.5

ERP_TASK_CORE_POOL_SIZE=2
ERP_TASK_MAX_POOL_SIZE=4
ERP_TASK_QUEUE_CAPACITY=50
ERP_TASK_OUTPUT_DIR=/data/backups/tasks/
ERP_CORS_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
LOG_MAX_SIZE=20m
LOG_MAX_FILE=5
LOG_FILE_DIR=/data/backups/logs/backend
LOG_FILE_MAX_SIZE=50MB
LOG_FILE_MAX_HISTORY=30
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
POSTGRES_LOG_MIN_DURATION_STATEMENT_MS=500
POSTGRES_DEADLOCK_TIMEOUT=1s
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPUS=1.0
BACKEND_MEM_LIMIT=1g
BACKEND_CPUS=1.0
FRONTEND_MEM_LIMIT=256m
FRONTEND_CPUS=0.5

# Production examples:
# POSTGRES_BIND=127.0.0.1
# BACKEND_BIND=127.0.0.1
# FRONTEND_BIND=127.0.0.1
# FRONTEND_PORT=8088
# ERP_CORS_ALLOWED_ORIGINS=https://erp.example.com
