POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_BIND=0.0.0.0
POSTGRES_PORT=5432
BACKEND_BIND=0.0.0.0
BACKEND_PORT=8080
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=8088
ERP_JWT_SECRET=change-this-secret-before-production
ERP_JWT_TTL_MINUTES=720
ERP_CORS_ALLOWED_ORIGINS=http://localhost:8088

# Production examples:
# POSTGRES_BIND=127.0.0.1
# BACKEND_BIND=127.0.0.1
