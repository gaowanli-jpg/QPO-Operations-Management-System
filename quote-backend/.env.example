SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=123456
ERP_UPLOAD_DIR=D:/ERP_Files/
ERP_BACKUP_DIR=D:/ERP_Files/backup/
ERP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8088,http://127.0.0.1:8088
ERP_AUTH_ENABLED=true
ERP_JWT_SECRET=please-change-this-long-random-secret
ERP_JWT_TTL_MINUTES=720
ERP_APS_SOURCE_TOKEN=please-set-the-same-value-as-APS_ERP_AUTH_TOKEN
FLYWAY_ENABLED=true
SQL_INIT_MODE=never
MYBATIS_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl
