APS_POSTGRES_DB=aps
APS_POSTGRES_USER=aps
APS_POSTGRES_PASSWORD=
APS_POSTGRES_VOLUME_NAME=aps_postgres_data_prod

APS_FRONTEND_BIND=127.0.0.1
APS_FRONTEND_PORT=8095

APS_AUTH_ENABLED=true
APS_JWT_SECRET=
APS_JWT_TTL_MINUTES=720

# Docker Desktop can usually reach the ERP backend through host.docker.internal.
# If ERP is deployed on another server, use that server's internal URL instead.
APS_ERP_BASE_URL=http://host.docker.internal:8080
APS_ERP_AUTH_TOKEN=
APS_ERP_SYNC_PAGE_SIZE=200

APS_CORS_ALLOWED_ORIGINS=http://localhost:8095,http://127.0.0.1:8095

APS_DB_POOL_MAX_SIZE=10
APS_DB_POOL_MIN_IDLE=2
APS_DB_POOL_CONNECTION_TIMEOUT_MS=3000
APS_DB_POOL_IDLE_TIMEOUT_MS=600000
APS_DB_POOL_MAX_LIFETIME_MS=1800000
APS_DB_POOL_VALIDATION_TIMEOUT_MS=3000

APS_LOG_MAX_SIZE=20m
APS_LOG_MAX_FILE=5
APS_POSTGRES_MEM_LIMIT=1g
APS_POSTGRES_CPUS=1.0
APS_BACKEND_MEM_LIMIT=1g
APS_BACKEND_CPUS=1.0
APS_FRONTEND_MEM_LIMIT=256m
APS_FRONTEND_CPUS=0.5
